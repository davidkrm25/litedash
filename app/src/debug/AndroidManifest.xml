<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Solo debug: ser la «app de ubicación simulada» para darle a toda la tableta el GPS del teléfono. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation" />
    <application android:networkSecurityConfig="@xml/network_test_config">
        <!-- Solo debug: sesión de música sin título, como el Bluetooth de muchas pantallas. -->
        <receiver android:name=".TestMediaSession" android:exported="true" tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="com.irvingguerra.litedash.TEST_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
